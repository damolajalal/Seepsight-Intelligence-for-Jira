{
  "name": "seepsight-intelligence-for-jira",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first procurement risk and action intelligence embedded in Jira.",
  "scripts": {
    "build:ui": "esbuild static/dashboard/app.js --bundle --outfile=static/dashboard/build/app.bundle.js --format=iife && esbuild static/issue-panel/app.js --bundle --outfile=static/issue-panel/build/app.bundle.js --format=iife",
    "lint": "forge lint",
    "test": "node --test",
    "start": "forge tunnel"
  },
  "dependencies": {
    "@forge/api": "latest",
    "@forge/bridge": "latest",
    "@forge/resolver": "latest"
  },
  "devDependencies": {
    "@forge/cli": "latest",
    "esbuild": "latest"
  }
}
